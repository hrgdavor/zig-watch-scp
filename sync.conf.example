# === Global Connection Settings ===
host=1.2.3.4
username=user

# SSH password (optional if key_path is used)
# password=secret

# SSH private key path (optional, overrides password auth if provided)
key_path=~/.ssh/id_rsa

# Passphrase for the private key (optional)
# passphrase=secret

# Threads used to scan and hash local files (default: 4).
# SSH transfers are serialized: the bundled libssh2 crypto backend keeps
# process-wide RNG state, so parallel SSH sessions corrupt memory.
parallel_threads=8

# Delay in milliseconds before starting sync after a change is detected (default: 200)
# Helps handle editors that save files in multiple steps (e.g. delete/create or multiple writes)
watch_delay_ms=500

# Enable SSH compression for faster transfers over slow connections (default: false)
compress=true

# Remote cleanup: remove files on remote that are not present locally
# This is performed during initial synchronization.
cleanup=false

# Text file extensions (for line ending normalization)
# text_extensions=.txt, .md, .zig, .java

# Change detection mode (default: hash)
# - hash: uses wyhash64 to detect content changes (most accurate)
# - mtime_size: uses file modification time and size (fastest, lightweight)
# check=hash

# Disable checksum database (.scpdb) on remote server (default: false)
# When true, skips downloading/uploading the database and uses direct stat checks.
# no_db=false

# === Folder Synchronization Pairs ===
# You must define one or more folder sections. Each section starts with [folder].

[folder]
scpdb=.scpdb
# Database file for THIS folder. Every folder must keep its own .scpdb: two
# folders that resolve to the same file (same remote_dir with the default name,
# or the same absolute scpdb) would overwrite each other's entries and re-upload
# everything on every run. With a shared remote_dir, give each folder a name:
#   scpdb=.scpdb.project-a
# create an index in local folder, optional, default .scpdb
local_db=false
# Local directory to watch and sync
local_dir=./src
# Remote directory to sync to
remote_dir=/opt/project/src
# Include patterns (comma-separated, optional)
includes=*.zig, *.h
# Exclude patterns (comma-separated, optional)
excludes=**/temp/**, **/*.tmp

[folder]
local_dir=./docs
remote_dir=/opt/project/docs
excludes=**/*.bak, .~*

# trigger_from=./trigger.local
# trigger_to=/tmp/sync-trigger.txt

# Version File Support
# Reads a local template, replaces ${timestamp} with current epoch, and uploads.
# Supports .json and .ini property replacement automatically.
# version_from=version.json.template
# version_to=version.json

# === Local-only copy workers (no SSH) ===
# [local-folder] serves as a target directory and expects one or more [source] entries.

[local-folder]
dest_dir=./build

[source]
local_dir=./src
includes=**/*.zig
excludes=**/*.tmp

[source]
local_dir=./assets

# === Command executed on remote after successful sync (optional) ===
# exec_cmd=touch /tmp/synced
# alias: exec=...

